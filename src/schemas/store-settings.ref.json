{
  "$id": "store-settings.ref.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "name": { "type": "string" },
    "tagline": { "type": "string" },
    "primaryColor": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
    "secondaryColor": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
    "inkColor": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
    "font": {
      "type": "string",
      "enum": ["inter", "poppins", "nunito", "montserrat", "roboto", "lato"]
    },
    "radius": { "type": "string", "enum": ["none", "soft", "rounded"] },
    "pageSize": { "type": "integer", "minimum": 1 },
    "catalogLayout": { "type": "string", "enum": ["grid", "list"] },
    "catalogColumns": { "type": "integer", "enum": [2, 3, 4] },
    "productImageAspect": { "type": "string", "enum": ["auto", "square", "landscape", "portrait"] },
    "whatsappNumber": { "type": "string", "pattern": "^[0-9]{10,15}$" },
    "phone": { "type": "string" },
    "email": { "type": "string" },
    "weekdayHours": { "type": "string" },
    "saturdayHours": { "type": "string" },
    "companyName": { "type": "string" },
    "cnpj": { "type": "string" },
    "address": { "type": "string" },
    "instagramUrl": { "type": "string" },
    "facebookUrl": { "type": "string" },
    "tiktokUrl": { "type": "string" },
    "youtubeUrl": { "type": "string" },
    "cashDiscountPercent": { "type": "number", "minimum": 0, "maximum": 100 },
    "maxInstallments": { "type": "integer", "minimum": 0 },
    "originZipCode": { "type": "string", "pattern": "^[0-9]{8}$" },
    "freeShippingAbove": { "type": "number", "minimum": 0 },
    "shippingRanges": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": { "type": "string" },
          "zipCodeStart": { "type": "string", "pattern": "^[0-9]{8}$" },
          "zipCodeEnd": { "type": "string", "pattern": "^[0-9]{8}$" },
          "price": { "type": "number", "minimum": 0 },
          "deliveryDays": { "type": "integer", "minimum": 0 }
        },
        "required": ["zipCodeStart", "zipCodeEnd", "price", "deliveryDays"],
        "additionalProperties": false
      }
    },
    "returnWindowDays": { "type": "integer", "minimum": 0 },
    "cancellationDeadlineHours": { "type": "integer", "minimum": 0 },
    "openingHours": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "weekday": { "type": "string", "enum": ["sunday", "monday", "tuesday", "wednesday", "thursday", "friday", "saturday"] },
          "opensAt": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
          "closesAt": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" }
        },
        "required": ["weekday", "opensAt", "closesAt"],
        "additionalProperties": false
      }
    },
    "timeZone": { "type": "string" },
    "pickupAddress": { "type": "string" },
    "deliveryDistricts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "price": { "type": "number", "minimum": 0 },
          "deliveryTime": { "type": "string" }
        },
        "required": ["name", "price"],
        "additionalProperties": false
      }
    },
    "minimumOrderValue": { "type": "number", "minimum": 0 },
    "payOnDeliveryOnly": { "type": "boolean" },
    "reservationMinutes": { "type": "integer", "minimum": 5, "maximum": 60 },
    "ordersPaused": { "type": "boolean" },
    "aboutText": { "type": "string" },
    "privacyPolicyText": { "type": "string" },
    "termsText": { "type": "string" },
    "returnsPolicyText": { "type": "string" },
    "cookieNoticeText": { "type": "string" },
    "banners": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "image": { "type": "string" },
          "title": { "type": "string", "minLength": 1 },
          "subtitle": { "type": "string" },
          "linkUrl": { "type": "string" },
          "linkLabel": { "type": "string" }
        },
        "required": ["title"],
        "additionalProperties": false
      }
    },
    "benefits": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "icon": { "type": "string" },
          "title": { "type": "string", "minLength": 1 },
          "text": { "type": "string" }
        },
        "required": ["title"],
        "additionalProperties": false
      }
    },
    "featuredProductIds": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "whatsappButtonEnabled": { "type": "boolean" },
    "stockAvailabilityEnabled": { "type": "boolean" },
    "cashDiscountEnabled": { "type": "boolean" },
    "installmentsEnabled": { "type": "boolean" },
    "favoritesEnabled": { "type": "boolean" },
    "blogEnabled": { "type": "boolean" },
    "shippingEnabled": { "type": "boolean" },
    "couponsEnabled": { "type": "boolean" },
    "reviewsEnabled": { "type": "boolean" },
    "openingHoursEnabled": { "type": "boolean" },
    "pickupEnabled": { "type": "boolean" },
    "districtDeliveryEnabled": { "type": "boolean" },
    "payOnDeliveryEnabled": { "type": "boolean" },
    "itemNotesEnabled": { "type": "boolean" },
    "productOptionsEnabled": { "type": "boolean" },
    "productVariantsEnabled": { "type": "boolean" },
    "stockReservationEnabled": { "type": "boolean" },
    "attendeesEnabled": { "type": "boolean" },
    "ticketsEnabled": { "type": "boolean" },
    "productBadgesEnabled": { "type": "boolean" },
    "couponShowcaseEnabled": { "type": "boolean" },
    "collectionsEnabled": { "type": "boolean" },
    "crossSellEnabled": { "type": "boolean" },
    "returnsEnabled": { "type": "boolean" }
  },
  "additionalProperties": false
}
