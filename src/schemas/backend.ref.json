{
  "$id": "backend.ref.json",
  "type": "object",
  "properties": {
    "environment": { "type": "string" },
    "baseUrl": { "type": "string" },
    "isActiveEnvironment": { "type": "boolean" },
    "framework": {
      "type": "string",
      "enum": ["functions", "lambda", "laravel", "nest", "dotnet"]
    },
    "database": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "enum": [
            "mariadb",
            "mongodb",
            "oracle",
            "postgresql",
            "mysql",
            "sqlserver",
            "sqlite"
          ]
        },
        "connectionString": { "type": "string" },
        "credentials": {
          "type": "object",
          "properties": {
            "username": { "type": "string" },
            "password": { "type": "string" },
            "host": { "type": "string" },
            "port": { "type": "integer" },
            "databaseName": { "type": "string" }
          },
          "required": ["username", "password", "host", "databaseName"]
        }
      },
      "required": ["provider", "connectionString", "credentials"]
    },
    "jwtSecret": { "type": "string" },
    "trustedCallers": {
      "type": "array",
      "items": { "$ref": "trusted-caller.ref.json" }
    },
    "referralSources": {
      "type": "array",
      "items": { "$ref": "referral-source-integration.ref.json" }
    },
    "scheduledJobs": {
      "type": "array",
      "items": { "$ref": "scheduled-job.ref.json" }
    },
    "storage": {
      "type": "object",
      "properties": {
        "provider": { "type": "string", "enum": ["gcs", "s3", "azure"] },
        "publicBucketName": { "type": "string" },
        "privateBucketName": { "type": "string" },
        "credentials": {
          "type": "object",
          "properties": {
            "projectId": { "type": "string" },
            "privateKey": { "type": "string" },
            "clientEmail": { "type": "string" }
          },
          "required": ["projectId", "privateKey", "clientEmail"]
        }
      },
      "required": [
        "provider",
        "publicBucketName",
        "privateBucketName",
        "credentials"
      ]
    },
    "logging": {
      "type": "object",
      "properties": {
        "discordWebhookUrl": { "type": "string" }
      }
    },
    "whatsapp": {
      "type": "object",
      "properties": {
        "whatsappToken": { "type": "string" },
        "whatsappPhoneNumberId": { "type": "string" },
        "whatsappVerifyToken": { "type": "string" }
      }
    },
    "aiAgentWhatsapp": {
      "type": "object",
      "properties": {
        "whatsappToken": { "type": "string" },
        "whatsappPhoneNumberId": { "type": "string" },
        "whatsappVerifyToken": { "type": "string" },
        "whatsappBusinessAccountId": { "type": "string" },
        "whatsappAppSecret": { "type": "string" }
      },
      "required": ["whatsappToken", "whatsappPhoneNumberId", "whatsappVerifyToken"]
    },
    "telegram": {
      "type": "object",
      "properties": {
        "telegramBotToken": { "type": "string", "minLength": 1 }
      },
      "required": ["telegramBotToken"],
      "additionalProperties": false
    },
    "email": {
      "type": "object",
      "properties": {
        "smtpUser": { "type": "string" },
        "smtpPass": { "type": "string" },
        "smtpFrom": { "type": "string" }
      }
    },
    "marketplace": {
      "type": "object",
      "properties": {
        "paymentGateways": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "provider": { "type": "string" }
            }
          }
        },
        "productsAutocomplete": { "$ref": "form-autocomplete.ref.json" },
        "stockInEndpoint": { "type": "string" },
        "stockOutEndpoint": { "type": "string" },
        "productBaseUrl": { "type": "string" },
        "productSellingSettingsEndpoint": { "type": "string" },
        "storeSettingsEndpoint": { "type": "string" },
        "sellerWorkspaceId": { "type": "string" },
        "sellerServiceAuth": {
          "type": "object",
          "properties": {
            "issuer": { "type": "string" },
            "audience": { "type": "string" },
            "privateKey": { "type": "string" },
            "keyId": { "type": "string" }
          },
          "required": ["issuer", "audience", "privateKey"]
        },
        "stockOutDefaults": {
          "type": "object",
          "additionalProperties": { "type": ["string", "number", "boolean"] }
        },
        "stockInAggregateEndpoint": { "type": "string" },
        "stockOutAggregateEndpoint": { "type": "string" },
        "storeOrdersEndpoint": { "type": "string" },
        "categoriesEndpoint": { "type": "string" },
        "brandsEndpoint": { "type": "string" },
        "productFieldMap": {
          "type": "object",
          "properties": {
            "category": { "type": "string", "minLength": 1 },
            "brand": { "type": "string", "minLength": 1 },
            "tags": { "type": "string", "minLength": 1 },
            "model": { "type": "string", "minLength": 1 },
            "weight": { "type": "string", "minLength": 1 },
            "height": { "type": "string", "minLength": 1 },
            "width": { "type": "string", "minLength": 1 },
            "length": { "type": "string", "minLength": 1 },
            "properties": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        }
      },
      "required": ["paymentGateways", "productsAutocomplete", "stockInEndpoint", "stockOutEndpoint", "productBaseUrl"]
    },
    "service": {
      "type": "object",
      "properties": {
        "paymentGateways": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "provider": { "type": "string" }
            }
          }
        },
        "appointmentList": { "$ref": "list.ref.json" },
        "availabilityScheduleList": { "$ref": "list.ref.json" },
        "appointmentByAiList": { "$ref": "list.ref.json" }
      },
      "required": ["paymentGateways", "appointmentList", "availabilityScheduleList"]
    },
    "mercadoPagoIntegration": {
      "type": "object",
      "properties": {
        "publicKey": { "type": "string" },
        "accessToken": { "type": "string" },
        "appId": { "type": "string" },
        "userId": { "type": "string" },
        "testUserId": { "type": "string" },
        "password": { "type": "string" },
        "verificationCode": { "type": "string" },
        "testSellerSettings": {
          "type": "object",
          "properties": {
            "userId": { "type": "string" },
            "user": { "type": "string" },
            "password": { "type": "string" },
            "verificationCode": { "type": "string" }
          },
          "required": ["userId", "user", "password", "verificationCode"]
        },
        "testBuyerSettings": {
          "type": "object",
          "properties": {
            "userId": { "type": "string" },
            "user": { "type": "string" },
            "password": { "type": "string" },
            "verificationCode": { "type": "string" }
          },
          "required": ["userId", "user", "password", "verificationCode"]
        }
      }
    }
  },
  "required": ["framework", "database", "jwtSecret"]
}
