{
  "$id": "project-store.ref.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "segment": {
      "type": "string",
      "enum": ["retail", "food", "services", "events"]
    },
    "features": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["whatsappButton", "stockAvailability", "cashDiscount", "installments", "favorites", "blog", "shipping", "coupons", "reviews", "returns", "openingHours", "pickup", "districtDelivery", "payOnDelivery", "itemNotes", "productOptions", "productVariants", "stockReservation", "attendees", "tickets", "productBadges", "couponShowcase", "collections", "crossSell", "loyalty"]
      },
      "uniqueItems": true
    },
    "defaults": { "$ref": "store-settings.ref.json" }
  },
  "additionalProperties": false
}
