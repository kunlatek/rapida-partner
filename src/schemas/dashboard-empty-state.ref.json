{
  "$id": "dashboard-empty-state.ref.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "description": "Estado vazio de um card do painel: ícone, título, explicação e ações.",
  "properties": {
    "icon": {
      "type": "string"
    },
    "title": {
      "$ref": "translatable.ref.json"
    },
    "description": {
      "$ref": "translatable.ref.json"
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "$ref": "translatable.ref.json"
          },
          "link": {
            "type": "string"
          },
          "variant": {
            "type": "string",
            "enum": ["primary", "secondary"]
          }
        },
        "required": ["label", "link"],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
