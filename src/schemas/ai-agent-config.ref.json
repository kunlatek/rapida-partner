{
  "$id": "ai-agent-config.ref.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "agentIdentity": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "systemPromptTemplate": {
          "type": "string",
          "description": "Conteúdo literal do system prompt em markdown (não um caminho de arquivo). Vazio, o gerador monta o prompt padrão."
        },
        "knowledgeBaseFile": {
          "type": "string"
        },
        "companyName": {
          "type": "string"
        },
        "mission": {
          "type": "string"
        },
        "knowledgeBaseContent": {
          "type": "string"
        }
      },
      "required": ["name", "systemPromptTemplate"],
      "additionalProperties": false
    },
    "infrastructure": {
      "type": "object",
      "properties": {
        "messengers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["whatsapp", "telegram"]
          }
        },
        "aiProvider": {
          "type": "string",
          "enum": ["deepseek", "gemini", "openai"]
        },
        "model": {
          "type": "string"
        }
      },
      "required": ["messengers", "aiProvider", "model"],
      "additionalProperties": false
    },
    "businessContext": {
      "type": "object",
      "properties": {
        "targetBackend": {
          "type": "object",
          "description": "Backend em outro projeto Rapida: rapidaObject.json compilado (relativo ao rapidaObject.json deste agente) e a URL dele.",
          "properties": {
            "definitionFile": { "type": "string", "minLength": 1 },
            "baseUrl": { "type": "string", "minLength": 1 }
          },
          "required": ["definitionFile", "baseUrl"],
          "additionalProperties": false
        },
        "exposedContracts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "contractId": {
                "type": "string"
              },
              "toolName": {
                "type": "string"
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "idPrompt": {
                "type": "string",
                "minLength": 1
              },
              "action": {
                "type": "string",
                "enum": [
                  "create",
                  "get",
                  "getById",
                  "update",
                  "softDelete",
                  "hardDelete"
                ]
              },
              "intentMapping": {
                "type": "object",
                "properties": {
                  "formFields": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "fieldId": {
                          "type": "string"
                        },
                        "naturalLanguagePrompt": {
                          "type": "string"
                        },
                        "validationHint": {
                          "type": "string"
                        },
                        "schemaType": {
                          "type": "string",
                          "enum": [
                            "string",
                            "number",
                            "integer",
                            "boolean",
                            "array",
                            "object"
                          ]
                        }
                      },
                      "required": ["fieldId", "naturalLanguagePrompt"],
                      "additionalProperties": false
                    }
                  },
                  "triggerKeywords": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "required": ["formFields", "triggerKeywords"],
                "additionalProperties": false
              },
              "responseTemplate": {
                "type": "object",
                "properties": {
                  "successMessage": {
                    "type": "string"
                  },
                  "errorMessage": {
                    "type": "string"
                  }
                },
                "required": ["successMessage", "errorMessage"],
                "additionalProperties": false
              }
            },
            "required": ["contractId", "toolName", "action", "intentMapping"],
            "additionalProperties": false
          }
        },
        "botCredentials": {
          "type": "object",
          "description": "Usuário de serviço do agente (BOT_API_EMAIL/BOT_API_PASSWORD no .env do agente e do backend); o backend gerado cria esse usuário ao subir.",
          "properties": {
            "email": {
              "type": "string",
              "minLength": 3
            },
            "password": {
              "type": "string",
              "minLength": 8
            }
          },
          "required": ["email", "password"],
          "additionalProperties": false
        }
      },
      "required": ["exposedContracts", "botCredentials"],
      "additionalProperties": false
    },
    "capabilities": {
      "type": "object",
      "properties": {
        "identity": { "type": "boolean" },
        "scheduling": { "type": "boolean" },
        "knowledgeBase": { "type": "boolean" },
        "media": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "humanHandoff": {
      "type": "object",
      "properties": {
        "contacts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "useCase": {
                "type": "string"
              },
              "whatsappPhoneNumber": {
                "type": "string",
                "pattern": "^\\+[1-9][0-9]{7,14}$"
              }
            },
            "required": ["name", "useCase", "whatsappPhoneNumber"],
            "additionalProperties": false
          }
        }
      },
      "required": ["contacts"],
      "additionalProperties": false
    },
    "audio": {
      "type": "object",
      "properties": {
        "maxDurationSeconds": {
          "type": "number",
          "minimum": 1
        },
        "rateLimitIntervalSeconds": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "jobs": {
      "type": "object",
      "properties": {
        "reminder": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "minutesAhead": {
              "type": "number",
              "minimum": 1
            },
            "recipients": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "enum": ["client", "professional"] }
            },
            "whatsappTemplates": {
              "type": "object",
              "properties": {
                "client": {
                  "type": "object",
                  "properties": {
                    "name": { "type": "string", "minLength": 1 },
                    "languageCode": { "type": "string", "minLength": 2 }
                  },
                  "required": ["name"],
                  "additionalProperties": false
                },
                "professional": {
                  "type": "object",
                  "properties": {
                    "name": { "type": "string", "minLength": 1 },
                    "languageCode": { "type": "string", "minLength": 2 }
                  },
                  "required": ["name"],
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "required": ["agentIdentity", "infrastructure", "businessContext"],
  "additionalProperties": false
}
