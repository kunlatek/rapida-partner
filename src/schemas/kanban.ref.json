{
  "$id": "kanban.ref.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "componentType": {
      "const": "kanban"
    },
    "id": {
      "type": "string"
    },
    "relatedFormId": {
      "type": "string",
      "description": "ID do formulário relacionado para criação/edição de cards (opcional)"
    },
    "itemsLabel": {
      "$ref": "translatable.ref.json",
      "description": "Nome dos cards no plural, usado no resumo e na contagem. e.g.: 'tarefas'"
    },
    "createLabel": {
      "$ref": "translatable.ref.json",
      "description": "Texto do botão de criar. e.g.: 'Nova tarefa'"
    },
    "columnTones": {
      "type": "object",
      "description": "Cor do ponto de cada coluna, pelo valor da coluna.",
      "additionalProperties": { "type": "string", "enum": ["neutral", "info", "success", "warning", "danger", "accent"] }
    },
    "doneColumns": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Valores das colunas finais: cards nelas não contam como atrasados."
    },
    "hideEmptyColumns": {
      "type": "boolean",
      "description": "Começa recolhendo as colunas sem cards; padrão true."
    },
    "quickFilters": {
      "type": "array",
      "description": "Botões de filtro rápido com contador, abaixo da busca.",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "label": { "$ref": "translatable.ref.json" },
          "tone": { "type": "string", "enum": ["neutral", "info", "success", "warning", "danger", "accent"] },
          "property": { "type": "string" },
          "match": { "type": "string", "enum": ["overdue", "dueToday", "equals"] },
          "value": { "type": ["string", "number", "boolean"] }
        },
        "required": ["id", "label", "property", "match"],
        "additionalProperties": false
      }
    },
    "boardsProperty": {
      "$ref": "form-autocomplete.ref.json",
      "description": "Element autocomplete que associa o card a um board e precisa estar presente no form de tasks relacionados ao kanban"
    },
    "userStory": {
      "type": "string"
    },
    "guards": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dataSource": {
      "$ref": "form-common-api-request.ref.json"
    },
    "kanbanColumnsProperty": {
      "oneOf": [
        {
          "$ref": "form-autocomplete.ref.json"
        },
        {
          "$ref": "form-select.ref.json"
        }
      ]
    },
    "businessRules": {
      "$ref": "business-rules.ref.json"
    },
    "kanbanCardItems": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "property": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "title",
              "subtitle",
              "description",
              "video",
              "image",
              "images",
              "icon",
              "badge",
              "editable",
              "person",
              "level"
            ]
          },
          "isHtml": {
            "type": "boolean"
          },
          "isTimestamp": {
            "type": "boolean"
          },
          "callToAction": {
            "type": "object",
            "properties": {
              "link": {
                "type": "string"
              },
              "usePropertyAsQuery": {
                "type": "boolean"
              }
            },
            "required": ["link"]
          },
          "dataType": {
            "$ref": "types-datatype.ref.json"
          },
          "isExpansible": {
            "type": "boolean"
          },
          "tones": {
            "type": "object",
            "description": "type 'badge': tom de cada valor.",
            "additionalProperties": { "type": "string", "enum": ["neutral", "info", "success", "warning", "danger", "accent"] }
          },
          "icons": {
            "type": "object",
            "description": "type 'badge': ícone Lucide de cada valor.",
            "additionalProperties": { "type": "string" }
          },
          "relativeDate": {
            "type": "string",
            "enum": ["plain", "deadline"],
            "description": "Datas: texto relativo ('em 3 dias'); 'deadline' pinta o atraso de vermelho e os próximos 7 dias de âmbar."
          },
          "levels": {
            "type": "array",
            "items": { "type": ["string", "number"] },
            "description": "type 'level': valores do menor para o maior, um tracinho por valor."
          },
          "roleShort": {
            "type": "string",
            "description": "type 'person': letra do papel no avatar."
          },
          "labelFields": {
            "type": "array",
            "items": { "type": "string" },
            "description": "type 'person': campos do nome da pessoa; sem isso, os do autocomplete de mesmo nome no form relacionado."
          },
          "conditions": {
            "$ref": "condition.ref.json"
          },
          "businessRules": {
            "$ref": "business-rules.ref.json"
          },
          "todo": {
            "type": "string"
          }
        },
        "required": ["dataType"]
      }
    },
    "kanbanFilters": {
      "$ref": "form-one-of.ref.json"
    },
    "callsToActionMenu": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "icon": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "action": {
            "type": "object",
            "properties": {
              "linkAfterAction": {
                "type": "object",
                "properties": {
                  "endpoint": {
                    "type": "string"
                  },
                  "propertiesAsQueryParam": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "propertiesAsPathParam": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "required": ["endpoint"]
              },
              "link": {
                "type": "object",
                "properties": {
                  "endpoint": {
                    "type": "string"
                  },
                  "propertiesAsQueryParam": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "propertiesAsPathParam": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "required": ["endpoint"]
              },
              "request": {
                "type": "object",
                "properties": {
                  "endpoint": {
                    "type": "string"
                  },
                  "propertiesAsQueryParam": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "propertiesAsPathParam": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "verb": {
                    "type": "string",
                    "enum": ["get", "post", "put", "softDelete", "hardDelete"]
                  },
                  "dialog": {
                    "type": "object",
                    "properties": {
                      "title": {
                        "type": "string"
                      },
                      "message": {
                        "type": "string"
                      }
                    },
                    "required": ["title", "message"]
                  }
                },
                "required": ["endpoint", "verb"]
              }
            }
          }
        },
        "businessRules": {
          "$ref": "business-rules.ref.json"
        },
        "conditions": {
          "$ref": "condition.ref.json"
        },
        "todo": {
          "type": "string"
        }
      },
      "required": ["icon", "label", "action"]
    },
    "contracts": {
      "type": "array",
      "items": {
        "$ref": "form-contract.ref.json"
      }
    },
    "publicContracts": {
      "type": "array",
      "items": {
        "$ref": "form-public-contract.ref.json"
      }
    },
    "archive": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "property": {
            "type": "string"
          },
          "value": {
            "type": "string"
          },
          "logicalOperator": {
            "type": "string",
            "enum": ["&&", "!", "nor", "||"]
          }
        },
        "required": ["property", "value"]
      }
    }
  },
  "required": [
    "componentType",
    "id",
    "boardsProperty",
    "dataSource",
    "kanbanColumnsProperty",
    "kanbanCardItems",
    "contracts"
  ]
}
