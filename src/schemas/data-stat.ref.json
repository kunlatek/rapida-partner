{
  "$id": "data-stat.ref.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "componentType": {
      "const": "dataStat"
    },
    "id": {
      "type": "string"
    },
    "title": {
      "$ref": "translatable.ref.json"
    },
    "subtitle": {
      "$ref": "translatable.ref.json"
    },
    "userStory": {
      "type": "string"
    },
    "icon": {
      "type": "string"
    },
    "guards": {
      "type": "string",
      "enum": ["isAuthenticated", "isAuthorized"]
    },
    "businessRules": {
      "$ref": "business-rules.ref.json"
    },
    "dataSource": {
      "$ref": "form-common-api-request.ref.json"
    },
    "filters": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "comparisonOperator": {
            "enum": ["===", ">", ">=", "in", "<", "<=", "!==", "nin"]
          },
          "value": {
            "description": "Valor comparado. Aceita as datas relativas \"$now\", \"$today\", \"$tomorrow\", \"$startOfMonth\", \"$startOfNextMonth\", \"$startOfYear\" e \"$startOfNextYear\"; \"in\"/\"nin\" recebem uma lista."
          }
        },
        "required": ["key", "comparisonOperator", "value"],
        "additionalProperties": false,
        "if": {
          "properties": { "comparisonOperator": { "enum": ["in", "nin"] } }
        },
        "then": {
          "properties": { "value": { "type": "array" } }
        }
      }
    },
    "value": {
      "type": "object",
      "properties": {
        "aggregator": {
          "type": "string",
          "enum": ["sum", "avg", "min", "max", "count"]
        },
        "property": {
          "type": "string"
        },
        "dataType": {
          "$ref": "types-datatype.ref.json"
        }
      },
      "required": ["aggregator"],
      "additionalProperties": false,
      "if": {
        "properties": { "aggregator": { "not": { "const": "count" } } }
      },
      "then": {
        "required": ["property"]
      }
    },
    "tone": {
      "type": "object",
      "description": "Cor do card conforme o valor calculado. A primeira regra que casar define o tom; sem nenhuma, vale default (\"neutral\").",
      "properties": {
        "default": {
          "$ref": "tone.ref.json"
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "comparisonOperator": {
                "enum": ["===", ">", ">=", "in", "<", "<=", "!==", "nin"]
              },
              "value": {
                "description": "Valor comparado com o resultado. Aceita as mesmas datas relativas dos filtros."
              },
              "tone": {
                "$ref": "tone.ref.json"
              }
            },
            "required": ["comparisonOperator", "value", "tone"],
            "additionalProperties": false,
            "if": {
              "properties": { "comparisonOperator": { "enum": ["in", "nin"] } }
            },
            "then": {
              "properties": { "value": { "type": "array" } }
            }
          }
        }
      },
      "additionalProperties": false
    },
    "limit": {
      "type": "integer",
      "minimum": 1
    },
    "link": {
      "type": "string"
    },
    "action": {
      "allOf": [
        {
          "$ref": "dashboard-link-action.ref.json"
        }
      ],
      "properties": {
        "label": true,
        "route": true
      },
      "additionalProperties": false
    },
    "emptyState": {
      "$ref": "dashboard-empty-state.ref.json"
    },
    "space": {
      "type": "integer",
      "enum": [1, 2, 3, 4]
    }
  },
  "required": ["componentType", "id", "title", "dataSource", "value"],
  "additionalProperties": false
}
