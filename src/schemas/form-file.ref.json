{
  "$id": "form-file.ref.json",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "file"
    },
    "name": {
      "type": "string"
    },
    "dataType": {
      "type": "string",
      "$ref": "types-datatype.ref.json"
    },
    "label": {
      "$ref": "translatable.ref.json"
    },
    "placeholder": {
      "$ref": "translatable.ref.json"
    },
    "tooltip": {
      "$ref": "translatable.ref.json"
    },
    "accept": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "isMultiple": {
      "type": "boolean"
    },
    "isProfilePicture": {
      "type": "boolean",
      "description": "Marks this file element as the user's profile picture. Only meaningful in flows.profiles.personProfile/companyProfile forms, at most one per form and never inside an array element."
    },
    "maxSize": {
      "type": "number"
    },
    "isDisabled": {
      "type": "boolean"
    },
    "isDisabledOnUpdate": {
      "type": "boolean"
    },
    "isHidden": {
      "type": "boolean"
    },
    "isRequired": {
      "type": "boolean"
    },
    "conditions": {
      "$ref": "condition.ref.json"
    },
    "todo": {
      "type": "string"
    },
    "businessRules": {
      "$ref": "business-rules.ref.json"
    },
    "elementDescription": {
      "type": "string"
    },
    "space": {
      "type": "number",
      "enum": [
        1,
        2,
        3,
        4
      ]
    },
    "validators": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "onlyImages",
          "png",
          "jpg",
          "pdf"
        ]
      }
    },
    "storageConfig": {
      "$ref": "storage-config.ref.json"
    }
  },
  "required": [
    "type",
    "name",
    "label",
    "storageConfig"
  ]
}