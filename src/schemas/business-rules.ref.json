{
  "$id": "business-rules.ref.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "rule": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string"
          },
          "implementation": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "frontend",
                  "backend",
                  "both"
                ]
              },
              "details": {
                "type": "string"
              }
            },
            "required": [
              "type",
              "details"
            ]
          },
          "backendComplementaryCode": {
            "type": "object",
            "properties": {
              "framework": {
                "type": "string",
                "enum": [
                  "functions",
                  "lambda",
                  "laravel",
                  "nest",
                  "dotnet"
                ]
              },
              "code": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "codeStartLocationReference": {
                      "type": "string",
                      "enum": [
                        "before",
                        "after",
                        "replace"
                      ]
                    },
                    "codeStartLocation": {
                      "type": "string"
                    },
                    "code": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "codeStartLocationReference",
                    "code"
                  ]
                }
              },
              "dependencies": {
                "type": "object",
                "description": "Pacotes npm que o código complementar precisa, nome -> versão exata (ex.: \"exceljs\": \"4.4.0\"). O gerador soma ao package.json do lado (backend/frontend) quando o framework bate com o ativo.",
                "additionalProperties": {
                  "type": "string",
                  "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?$"
                }
              },
              "devDependencies": {
                "type": "object",
                "description": "Como dependencies, mas vai para devDependencies do package.json.",
                "additionalProperties": {
                  "type": "string",
                  "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?$"
                }
              },
              "files": {
                "type": "array",
                "description": "Arquivos novos que o código complementar cria no projeto gerado (ex.: testes unitários, fixtures). path é relativo à raiz do projeto gerado, sem '..' e sem caminho absoluto; a geração falha se o arquivo já existir.",
                "items": {
                  "type": "object",
                  "properties": {
                    "path": {
                      "type": "string",
                      "pattern": "^(?![/\\\\])(?!.*(^|[/\\\\])\\.\\.([/\\\\]|$))[^\\0]+$"
                    },
                    "content": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "path",
                    "content"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "framework",
              "code"
            ]
          },
