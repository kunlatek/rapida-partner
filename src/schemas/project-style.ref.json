{
  "$id": "project-style.ref.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "themeName": {
      "type": "string"
    },
    "colors": {
      "type": "object",
      "properties": {
        "primary": { "type": "string" },
        "primaryContrast": { "type": "string" },
        "secondary": { "type": "string" },
        "secondaryContrast": { "type": "string" },
        "background": { "type": "string" },
        "error": { "type": "string" },
        "success": { "type": "string" }
      }
    },
    "borders": {
      "type": "object",
      "properties": {
        "borderRadius": { "type": "string" }
      }
    }
  },
  "required": [
    "themeName"
  ]
}
